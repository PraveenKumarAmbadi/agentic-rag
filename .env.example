# Copy to .env and adjust:   cp .env.example .env
# .env is gitignored — it holds your API key.

# --- Required -----------------------------------------------------------------
# API key(s) clients must send as the X-API-Key header (comma-separate several
# keys to rotate). At least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENTIC_RAG_API_KEYS=

# --- LLM ------------------------------------------------------------------------
# Default: Ollama runs inside Docker (the "bundled-ollama" profile) and the
# model is pulled automatically on first start.
COMPOSE_PROFILES=bundled-ollama
LLM_MODEL=qwen2.5:7b-instruct
# Using an Ollama installed natively on this machine instead (see README):
#   COMPOSE_PROFILES=
#   LLM_BASE_URL=http://host.docker.internal:11434

# --- NVIDIA GPU (optional) ----------------------------------------------------
# Needs the NVIDIA Container Toolkit. Rebuild after changing: docker compose build
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# TORCH_VARIANT=cu130

# --- CPU-only machines (optional) -----------------------------------------------
# A 7B model on CPU needs minutes per agent answer. Either use a smaller model
# (faster, lower quality — eval numbers are only comparable on the 7B model)...
# LLM_MODEL=qwen2.5:3b-instruct
# ...and/or give requests more time:
# AGENTIC_RAG__LLM__READ_TIMEOUT_S=300
# AGENTIC_RAG__AGENT__REQUEST_TIMEOUT_S=600
# AGENTIC_RAG__SERVING__HARD_TIMEOUT_S=900

# --- Other ------------------------------------------------------------------------
# CPU threads for the one-time index build (default 4). More = faster but the
# machine runs hotter; fewer = cooler and slower. Ignored when building on GPU.
# INDEXER_THREADS=4
# Host port for the API (always bound to 127.0.0.1).
# API_PORT=8001
# Any config key can be overridden as AGENTIC_RAG__<SECTION>__<KEY>, e.g.
# AGENTIC_RAG__AGENT__MODE=baseline
